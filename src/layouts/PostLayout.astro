---
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SkinProfile from '../components/SkinProfile.astro';
import TableOfContents from '../components/TableOfContents.astro';
import VerdictBox from '../components/VerdictBox.astro';
import { getPostUrl, getRelatedPosts, type Post } from '../lib/posts';
import { formatLongDate } from '../lib/dates';
import { getCategoryLabel, site } from '../site';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: Post;
  headings: Heading[];
}

const { post, headings } = Astro.props;
const { data } = post;
const path = getPostUrl(post);
const related = await getRelatedPosts(post);
const categoryLabel = getCategoryLabel(data.category);
const isRoutine = data.category === 'routines';
const isLongRoutineTitle = data.slug === 'my-morning-and-evening-skincare-routine';
const isGlassSkinNote = data.slug === 'what-is-glass-skin';
const isProductReviewCopy = !isRoutine && !isGlassSkinNote;

const articleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  author: {
    '@type': 'Person',
    name: data.author,
    url: `${site.url}/about/`,
  },
  mainEntityOfPage: new URL(path, site.url).href,
  publisher: {
    '@type': 'Person',
    name: site.author.name,
  },
};

if (data.publishedAt) {
  articleLd.datePublished = data.publishedAt.toISOString();
}
if (data.updatedAt) {
  articleLd.dateModified = data.updatedAt.toISOString();
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${site.url}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryLabel,
      item: `${site.url}/${data.category}/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title,
      item: new URL(path, site.url).href,
    },
  ],
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalPath={path}
  ogType="article"
  jsonLd={[articleLd, breadcrumbLd]}
  noindex={data.draft}
>
  <article class:list={["article-page", { "article-page-long-routine-title": isLongRoutineTitle }]}>
    <header class:list={["article-header", { "article-header-with-image": data.heroImage }]}>
      <div class="article-header-inner">
        <div class="article-header-copy">
          <p class="section-kicker">{isProductReviewCopy ? 'Honest review' : 'Honest note'} · {categoryLabel}</p>
          <h1 class="article-title">{data.title}</h1>
          <p class="article-dek">{data.description}</p>
          <p class="article-meta">
            {isProductReviewCopy ? `Tested and written by ${data.author}` : `Written by ${data.author}`}
            {
              data.publishedAt && (
                <>
                  {' '}
                  · <time datetime={data.publishedAt.toISOString()}>
                    {formatLongDate(data.publishedAt)}
                  </time>
                </>
              )
            }
          </p>
          {data.repurchase === 'yes' && <span class="article-status">Repurchased</span>}
        </div>
        {
          data.heroImage && (
            <figure class="article-hero-media">
              <img src={data.heroImage} alt={data.heroImageAlt ?? ''} />
              <figcaption>Photographed from my own shelf.</figcaption>
            </figure>
          )
        }
      </div>
      {
        import.meta.env.DEV && !data.heroImage && (
          <p class="dev-note">Development only: add a real product photo before publishing. No image is shown on the public page.</p>
        )
      }
    </header>

    <div class="article-body prose">
      <p class="disclosure">
        {
          isRoutine ? (
            <>
              This is a personal-use note, not medical advice. {data.author} wrote this from products she
              uses in her own routine. If this page later includes affiliate links, that will be stated
              here. Skin responses vary.
            </>
          ) : isGlassSkinNote ? (
            <>
              This is a short editorial note, not medical advice. If this page later includes affiliate
              links, that will be stated here. Skin responses vary.
            </>
          ) : (
            <>
              This is a personal-use note, not medical advice. {data.author} bought this product herself.
              If this page later includes affiliate links, that will be stated here. Skin responses vary.
            </>
          )
        }
      </p>
      <div class="review-snapshot">
        {
          !isGlassSkinNote && (
            <SkinProfile
              skinType={data.skinType}
              testedFor={data.testedFor}
              showShopping={!isRoutine}
            />
          )
        }
        <VerdictBox verdict={data.verdict} title={isGlassSkinNote ? 'Takeaway' : undefined} />
      </div>
      <TableOfContents headings={headings} />
      <slot />
      <AuthorBio />
    </div>
    <RelatedPosts posts={related} />
  </article>
</BaseLayout>
