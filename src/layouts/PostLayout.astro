---
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SkinProfile from '../components/SkinProfile.astro';
import TableOfContents from '../components/TableOfContents.astro';
import VerdictBox from '../components/VerdictBox.astro';
import { getPostUrl, getRelatedPosts, type Post } from '../lib/posts';
import { formatLongDate } from '../lib/dates';
import { getCategoryLabel, site } from '../site';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: Post;
  headings: Heading[];
}

const { post, headings } = Astro.props;
const { data } = post;
const path = getPostUrl(post);
const related = await getRelatedPosts(post);
const categoryLabel = getCategoryLabel(data.category);
const isRoutine = data.category === 'routines';
const isLongRoutineTitle = data.slug === 'my-morning-and-evening-skincare-routine';
const trendGuideBySlug: Record<
  string,
  {
    eyebrow: string;
    verdictTitle: string;
    disclosure?: string;
    contextTitle?: string;
    facts?: { label: string; value: string }[];
  }
> = {
  'what-is-glass-skin': {
    eyebrow: 'Trend guide · Glass Skin',
    verdictTitle: 'Takeaway',
    disclosure: 'This is an editorial trend guide with general skincare background, not medical advice. Personal routine observations are identified separately. If this page later includes affiliate links, that will be stated here. Skin responses vary.',
  },
  'mochi-skin-vs-glass-skin': {
    eyebrow: 'Trend guide · Mochi Skin',
    verdictTitle: 'Takeaway',
  },
  'do-you-need-a-10-step-korean-skincare-routine': {
    eyebrow: 'Trend guide · Routine Length',
    verdictTitle: 'Takeaway',
  },
  'what-are-capsule-creams': {
    eyebrow: 'Trend guide · Capsule Creams',
    verdictTitle: 'The short answer',
    contextTitle: 'What this trend means',
    facts: [
      { label: 'Format', value: 'Moisturizer with visible capsules' },
      { label: 'Main appeal', value: 'Texture and customization' },
      { label: 'Evidence', value: 'Depends on the complete formula' },
      { label: 'Need one?', value: 'No' },
    ],
  },
  'what-are-toner-pads': {
    eyebrow: 'Trend guide · Toner Pads',
    verdictTitle: 'The short answer',
    contextTitle: 'What this trend means',
    facts: [
      { label: 'Format', value: 'A pad already soaked in formula' },
      { label: 'Possible jobs', value: 'Hydration, exfoliation, or a mini mask' },
      { label: 'Evidence', value: 'Directions are not clinical proof' },
      { label: 'Need one?', value: 'No' },
    ],
  },
};
const trendGuide = trendGuideBySlug[data.slug];
const isTrendGuide = Boolean(trendGuide);
const ingredientGuideBySlug: Record<
  string,
  {
    eyebrow: string;
    seoTitle?: string;
    disclosure: 'personal-experience' | 'research-only';
    contextTitle: string;
    facts: { label: string; value: string }[];
    verdictTitle?: string;
  }
> = {
  'niacinamide-for-skin': {
    eyebrow: 'Ingredient guide · Niacinamide',
    seoTitle: 'Niacinamide for Skin: Benefits, How to Use, Retinol',
    disclosure: 'personal-experience',
    contextTitle: 'My skin & context',
    facts: [
      { label: 'Skin', value: data.skinType ?? site.author.skinType },
      { label: 'Goals', value: 'Smoother Texture / More Even-Looking Tone' },
      { label: 'Concentration I Use', value: '10%' },
      { label: 'Experience', value: 'No Irritation So Far' },
    ],
  },
  'does-pdrn-skincare-work': {
    eyebrow: 'Ingredient guide · PDRN',
    disclosure: 'personal-experience',
    contextTitle: 'My skin & context',
    facts: [
      { label: 'Skin', value: data.skinType ?? site.author.skinType },
      { label: 'Products tried', value: 'Two medicube PDRN formulas' },
      { label: 'Focus', value: 'What I noticed, not a miracle claim' },
    ],
    verdictTitle: 'Kay’s take',
  },
  'retinol-for-beginners': {
    eyebrow: 'Ingredient guide · Retinol',
    disclosure: 'personal-experience',
    contextTitle: 'My skin & context',
    facts: [
      { label: 'Skin', value: data.skinType ?? site.author.skinType },
      { label: 'Product I use', value: 'The Ordinary Retinol 0.2% in Squalane' },
      { label: 'Pace', value: 'About once every three days' },
    ],
    verdictTitle: 'Kay’s take',
  },
  'copper-peptides-for-skin': {
    eyebrow: 'Ingredient guide · Copper Peptides',
    disclosure: 'research-only',
    contextTitle: 'What this guide covers',
    facts: [
      { label: 'Topic', value: 'Copper Peptides' },
      { label: 'Common INCI', value: 'Copper Tripeptide-1' },
      { label: 'Evidence', value: 'Promising but Limited' },
      { label: 'Personal Use', value: 'Not Personally Tested' },
    ],
    verdictTitle: 'The short answer',
  },
  'ceramides-vs-hyaluronic-acid': {
    eyebrow: 'Ingredient guide · Ceramides & HA',
    disclosure: 'personal-experience',
    contextTitle: 'My skin & context',
    facts: [
      { label: 'Skin', value: data.skinType ?? site.author.skinType },
      { label: 'Routine examples', value: 'Torriden serum and AESTURA cream' },
      { label: 'What this is not', value: 'An ingredient isolation test' },
    ],
    verdictTitle: 'The short answer',
  },
  'salicylic-acid-vs-glycolic-acid': {
    eyebrow: 'Ingredient guide · BHA & AHA',
    disclosure: 'research-only',
    contextTitle: 'What this guide covers',
    facts: [
      { label: 'Topic', value: 'Salicylic acid and glycolic acid' },
      { label: 'Families', value: 'BHA and AHA' },
      { label: 'Basis', value: 'Official guidance, not a personal test' },
      { label: 'Need both?', value: 'No' },
    ],
    verdictTitle: 'The short answer',
  },
};
const ingredientGuide = ingredientGuideBySlug[data.slug];
const isIngredientGuide = Boolean(ingredientGuide);
const stopNoteBySlug: Record<
  string,
  {
    eyebrow: string;
    contextTitle: string;
    facts: { label: string; value: string }[];
    verdictTitle?: string;
  }
> = {
  'why-cosrx-snail-96-mucin-essence-didnt-work-for-me': {
    eyebrow: "Honest note · What Didn't Work",
    contextTitle: 'My skin & context',
    facts: [
      { label: 'Skin', value: data.skinType ?? site.author.skinType },
      { label: 'Product', value: 'COSRX Advanced Snail 96 Mucin Power Essence' },
      { label: 'Result', value: 'Stopped after overnight reaction' },
    ],
    verdictTitle: 'Kay’s take',
  },
  'why-i-stopped-using-medicube-collagen-jelly-cream': {
    eyebrow: "Honest note · What Didn't Work",
    contextTitle: 'My skin & context',
    facts: [
      { label: 'Skin', value: data.skinType ?? site.author.skinType },
      { label: 'Product', value: 'medicube Collagen Jelly Cream' },
      { label: 'Result', value: 'Stopped after repeated reactions' },
    ],
    verdictTitle: 'Kay’s take',
  },
};
const stopNote = stopNoteBySlug[data.slug];
const isStopNote = Boolean(stopNote);
const isProductReviewCopy = !isRoutine && !isTrendGuide && !isIngredientGuide && !isStopNote;
const documentTitle = data.seoTitle ?? ingredientGuide?.seoTitle ?? data.title;

const articleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  author: {
    '@type': 'Person',
    name: data.author,
    url: `${site.url}/about/`,
  },
  mainEntityOfPage: new URL(path, site.url).href,
  publisher: {
    '@type': 'Person',
    name: site.author.name,
  },
};

if (data.publishedAt) {
  articleLd.datePublished = data.publishedAt.toISOString();
}
if (data.updatedAt) {
  articleLd.dateModified = data.updatedAt.toISOString();
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${site.url}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryLabel,
      item: `${site.url}/${data.category}/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title,
      item: new URL(path, site.url).href,
    },
  ],
};
---

<BaseLayout
  title={documentTitle}
  description={data.description}
  canonicalPath={path}
  ogType="article"
  jsonLd={[articleLd, breadcrumbLd]}
  noindex={data.draft}
>
  <article class:list={["article-page", { "article-page-long-routine-title": isLongRoutineTitle }]}>
    <header class:list={["article-header", { "article-header-with-image": data.heroImage }]}>
      <div class="article-header-inner">
        <div class="article-header-copy">
          <p class="section-kicker">
            {
              ingredientGuide
                ? ingredientGuide.eyebrow
                : trendGuide
                  ? trendGuide.eyebrow
                  : stopNote
                    ? stopNote.eyebrow
                    : `${isProductReviewCopy ? 'Honest review' : 'Honest note'} · ${categoryLabel}`
            }
          </p>
          <h1 class="article-title">{data.title}</h1>
          <p class="article-dek">{data.dek ?? data.description}</p>
          <p class="article-meta">
            {isProductReviewCopy ? `Tested and written by ${data.author}` : `Written by ${data.author}`}
            {
              data.publishedAt && (
                <>
                  {' '}
                  · <time datetime={data.publishedAt.toISOString()}>
                    {formatLongDate(data.publishedAt)}
                  </time>
                </>
              )
            }
          </p>
          {data.status === 'repurchased' && <span class="article-status">Repurchased</span>}
        </div>
        {
          data.heroImage && (
            <figure class="article-hero-media">
              <img src={data.heroImage} alt={data.heroImageAlt ?? ''} />
              <figcaption>Photographed from my own shelf.</figcaption>
            </figure>
          )
        }
      </div>
      {
        import.meta.env.DEV && !data.heroImage && (
          <p class="dev-note">Development only: add a real product photo before publishing. No image is shown on the public page.</p>
        )
      }
    </header>

    <div class="article-body prose">
      <p class="disclosure">
        {
          isRoutine ? (
            <>
              This is a personal-use note, not medical advice. {data.author} wrote this from products she
              uses in her own routine. If this page later includes affiliate links, that will be stated
              here. Skin responses vary.
            </>
          ) : isTrendGuide ? (
            <>
              {trendGuide?.disclosure ?? 'This is a short editorial note, not medical advice. If this page later includes affiliate links, that will be stated here. Skin responses vary.'}
            </>
          ) : ingredientGuide?.disclosure === 'personal-experience' ? (
            <>
              This is a personal experience note and educational ingredient guide, not medical advice. If
              this page later includes affiliate links, that will be stated here. Skin responses vary.
            </>
          ) : ingredientGuide?.disclosure === 'research-only' ? (
            <>
              This is an educational ingredient guide, not medical advice. It summarizes published research
              rather than personal product testing. If this page later includes affiliate links, that will
              be stated here. Skin responses vary.
            </>
          ) : isStopNote ? (
            <>Kay’s personal experience. Skin responses vary.</>
          ) : (
            <>
              This is a personal-use note, not medical advice. {data.author} bought this product herself.
              If this page later includes affiliate links, that will be stated here. Skin responses vary.
            </>
          )
        }
      </p>
      <div class="review-snapshot">
        {
          trendGuide?.facts ? (
            <SkinProfile title={trendGuide.contextTitle} facts={trendGuide.facts} />
          ) : ingredientGuide ? (
            <SkinProfile title={ingredientGuide.contextTitle} facts={ingredientGuide.facts} />
          ) : stopNote ? (
            <SkinProfile title={stopNote.contextTitle} facts={stopNote.facts} />
          ) : (
            !isTrendGuide && (
              data.frequency ? (
                <SkinProfile
                  title="My skin & test"
                  facts={[
                    { label: 'Skin', value: data.skinType ?? site.author.skinType },
                    ...(data.testedFor
                      ? [{ label: 'Tested For', value: data.testedFor, wide: true as const }]
                      : []),
                    { label: 'Frequency', value: data.frequency },
                    ...(!isRoutine
                      ? [
                          {
                            label: 'Bought from',
                            value: data.boughtFrom ?? site.author.shopping,
                          },
                        ]
                      : []),
                  ]}
                />
              ) : (
                <SkinProfile
                  skinType={data.skinType}
                  testedFor={data.testedFor}
                  boughtFrom={data.boughtFrom}
                  showShopping={!isRoutine}
                />
              )
            )
          )
        }
        <VerdictBox
          verdict={data.verdict}
          title={ingredientGuide?.verdictTitle ?? trendGuide?.verdictTitle ?? stopNote?.verdictTitle}
        />
      </div>
      <TableOfContents headings={headings} />
      <slot />
      <AuthorBio />
    </div>
    <RelatedPosts posts={related} />
  </article>
</BaseLayout>
