---
import { site } from '../site';

interface Props {
  skinType?: string;
  testedFor?: string;
  showShopping?: boolean;
}

const { skinType, testedFor, showShopping = true } = Astro.props;
---

<section class="skin-profile" aria-labelledby="skin-profile-title">
  <p class="snapshot-kicker">The context</p>
  <h2 class="skin-profile-title" id="skin-profile-title">My skin &amp; test</h2>
  <dl class="profile-facts">
    <div class="profile-fact">
      <dt>Skin</dt>
      <dd>{skinType ?? site.author.skinType}</dd>
    </div>
    <div class="profile-fact">
      <dt>Goals</dt>
      <dd>{site.author.goals}</dd>
    </div>
    {
      showShopping && (
        <div class="profile-fact">
          <dt>Bought from</dt>
          <dd>{site.author.shopping}</dd>
        </div>
      )
    }
    <div class="profile-fact">
      <dt>K-beauty use</dt>
      <dd>
        {site.author.experience}
        <br />
        {site.author.experienceSupporting}
      </dd>
    </div>
    {
      testedFor && (
        <div class="profile-fact profile-fact-wide">
          <dt>Tested For</dt>
          <dd>{testedFor}</dd>
        </div>
      )
    }
  </dl>
</section>
