---
import { getPostUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 3 } = Astro.props;
const href = getPostUrl(post);
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<a class="review-note-card" href={href}>
  {
    post.data.heroImage && (
      <div class="review-note-img">
        <img
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? `${post.data.productName ?? post.data.title} product photo`}
          loading="lazy"
        />
      </div>
    )
  }
  <div class="review-note-body">
    <div class="review-note-meta">
      <span class="review-note-kicker">Review Note</span>
      <span class="review-note-date">
        {post.data.publishedAt ? dateFormatter.format(post.data.publishedAt) : 'Recently added'}
      </span>
    </div>
    <Heading class="review-note-title">{post.data.productName ?? post.data.title}</Heading>
    <p class="review-note-desc">{post.data.description}</p>
  </div>
  <div class="review-note-arrow" aria-hidden="true">&#8594;</div>
</a>

<style>
  .review-note-card {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-card);
    box-shadow: 0 2px 8px rgba(25, 27, 26, 0.04);
    color: inherit;
    text-decoration: none;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .review-note-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(25, 27, 26, 0.09);
  }

  .review-note-img {
    width: 100%;
    flex-shrink: 0;
    aspect-ratio: 1.05;
    overflow: hidden;
    background: var(--bg-subtle);
  }

  .review-note-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: var(--media-lift);
  }

  .review-note-body {
    flex: 1;
    min-width: 0;
    padding: 1rem 1rem 3.4rem;
  }

  .review-note-card:not(:has(.review-note-img)) .review-note-body {
    padding-top: 1.15rem;
  }

  .review-note-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
    min-width: 0;
  }

  .review-note-kicker {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .review-note-date {
    font-size: 0.68rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .review-note-title {
    margin: 0 0 0.45rem;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }

  .review-note-card:hover .review-note-title {
    color: var(--sage-dark);
  }

  .review-note-desc {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ink-secondary);
    overflow-wrap: anywhere;
  }

  .review-note-arrow {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--terracotta);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    transition: transform 0.2s;
  }

  .review-note-card:hover .review-note-arrow {
    transform: scale(1.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .review-note-card,
    .review-note-arrow {
      transition: none;
    }
  }
</style>
