---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getPostUrl,
  getPublishedPosts,
  getRepurchasedPosts,
  type Post,
} from '../lib/posts';
import { site } from '../site';

const publishedPosts = await getPublishedPosts();
const finishedPosts = (await getRepurchasedPosts()).slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
const noteLabels: Record<string, string> = {
  reviews: 'Review Note',
  breakouts: 'Skin Note',
  comparisons: 'Comparison Note',
  routines: 'Routine Note',
  ingredients: 'Ingredient Column',
  trends: 'Trend Column',
  'beyond-k-beauty': 'Beauty Note',
};

type HomeTabId = 'all' | 'reviews' | 'ingredients' | 'trends' | 'routines';

const homeTabs: {
  id: HomeTabId;
  label: string;
  viewAllHref: string;
  emptyMessage: string;
  posts: Post[];
}[] = [
  {
    id: 'all',
    label: 'All',
    viewAllHref: '/journal/',
    emptyMessage: 'No published notes yet.',
    posts: publishedPosts.slice(0, 4),
  },
  {
    id: 'reviews',
    label: 'Reviews',
    viewAllHref: '/reviews/',
    emptyMessage: 'No product reviews published yet.',
    posts: publishedPosts.filter((post) => post.data.category === 'reviews').slice(0, 4),
  },
  {
    id: 'ingredients',
    label: 'Ingredients',
    viewAllHref: '/ingredients/',
    emptyMessage: 'No ingredient notes published yet.',
    posts: publishedPosts.filter((post) => post.data.category === 'ingredients').slice(0, 4),
  },
  {
    id: 'trends',
    label: 'Trends',
    viewAllHref: '/trends/',
    emptyMessage: 'No trend notes published yet.',
    posts: publishedPosts.filter((post) => post.data.category === 'trends').slice(0, 4),
  },
  {
    id: 'routines',
    label: 'Routines',
    viewAllHref: '/routines/',
    emptyMessage: 'No routine notes published yet.',
    posts: publishedPosts.filter((post) => post.data.category === 'routines').slice(0, 4),
  },
];
---

<BaseLayout
  title={site.name}
  description={site.tagline}
  canonicalPath="/"
>
  <!-- HERO: 2-column split -->
  <section class="d1-hero">
    <div class="d1-wrap d1-hero-grid">
      <!-- Left: Text -->
      <div class="d1-hero-left">
        <p class="d1-kicker">REAL TESTS. REAL SKIN. A CALMER TRUTH.</p>
        <h1 class="d1-hero-title">Tested on sensitive<br/>skin. Told honestly.</h1>
        <p class="d1-hero-desc">
          A personal, evidence-in-use journal for K-beauty.
          Thoughtful tests, real-life results, and what I'd actually buy again.
        </p>
        <a class="d1-btn-terra" href="/about/">Explore My Journal &rarr;</a>
        <p class="d1-hero-subline">
          <span class="d1-subline-dash"></span>
          SAME SKIN &nbsp;/&nbsp; MORE ANSWERS &nbsp;/&nbsp; KINDER BEAUTY
        </p>
      </div>
      <!-- Right: real texture footage -->
      <div class="d1-hero-right">
        <div class="d1-media-box">
          <video class="d1-hero-video" autoplay loop muted playsinline preload="metadata" aria-label="A close look at skincare serum texture being spread across the back of a hand">
            <source src="/media/products/torriden-dive-in-serum/spreading.mp4" type="video/mp4" />
          </video>
          <div class="d1-media-shade"></div>
          <p class="d1-media-script">Same skin.<br/>More truth.</p>
          <span class="d1-media-corner-tag">TEXTURES TELL<br/>STORIES TOO.</span>
          <span class="d1-media-bottom-tag">REAL TEXTURE &middot; NO FILTER</span>
        </div>
      </div>
    </div>
  </section>

  <!-- MY SKIN PROFILE BAR -->
  <div class="d1-wrap">
    <div class="d1-profile-bar">
      <div class="d1-profile-brand">
        <h2 class="d1-profile-title">My Skin Profile</h2>
        <p class="d1-profile-tagline">BECAUSE CONTEXT MATTERS</p>
      </div>
      <div class="d1-profile-items">
        <div class="d1-profile-item">
          <span class="d1-profile-icon">🌿</span>
          <div>
            <div class="d1-profile-item-label">Dry + Somewhat Sensitive</div>
            <div class="d1-profile-item-value">Dry skin that can occasionally react</div>
          </div>
        </div>
        <div class="d1-profile-item">
          <span class="d1-profile-icon">☀️</span>
          <div>
            <div class="d1-profile-item-label">Main Concerns</div>
            <div class="d1-profile-item-value">Dryness, dehydration, early signs of aging</div>
          </div>
        </div>
        <div class="d1-profile-item">
          <span class="d1-profile-icon">💧</span>
          <div>
            <div class="d1-profile-item-label">Skin Goals</div>
            <div class="d1-profile-item-value">Hydration, barrier support, healthy-looking skin</div>
          </div>
        </div>
      </div>
      <a class="d1-profile-btn" href="/about/">Edit Profile &rarr;</a>
    </div>
  </div>

  <!-- LATEST NOTES -->
  <div class="d1-wrap d1-cards-section">
    <div class="d1-latest-section-head">
      <h2 class="d1-latest-section-title">Latest Notes</h2>
      <div class="d1-latest-section-meta">
        <span class="d1-tab-right-label">NEW NOTES, HONESTLY DOCUMENTED.</span>
        <a class="d1-latest-viewall" data-home-view-all href="/journal/">View All &rarr;</a>
      </div>
    </div>

    <div class="d1-tab-bar">
      <div class="d1-tabs" role="tablist" aria-label="Latest notes categories">
        {homeTabs.map((tab, index) => (
          <button
            type="button"
            class:list={['d1-tab', { 'd1-tab-active': index === 0 }]}
            role="tab"
            id={`home-tab-${tab.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`home-panel-${tab.id}`}
            tabindex={index === 0 ? 0 : -1}
            data-home-tab={tab.id}
            data-view-href={tab.viewAllHref}
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>

    {homeTabs.map((tab, index) => (
      <div
        class="d1-home-panel"
        role="tabpanel"
        id={`home-panel-${tab.id}`}
        aria-labelledby={`home-tab-${tab.id}`}
        data-home-panel={tab.id}
        hidden={index !== 0}
      >
        {tab.posts.length === 0 && <p class="d1-empty-notes">{tab.emptyMessage}</p>}
        <div class="d1-cards-grid">
          {tab.posts.map((post) => (
            <a class="d1-prod-card" href={getPostUrl(post)}>
              {post.data.heroImage && (
                <div class="d1-prod-img">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt ?? `${post.data.productName ?? post.data.title} product photo`}
                    loading="lazy"
                  />
                </div>
              )}
              <div class="d1-prod-body">
                <div class="d1-prod-meta-row">
                  <span class="d1-prod-kicker">{noteLabels[post.data.category] ?? 'Journal Note'}</span>
                  <span class="d1-prod-date">
                    {post.data.publishedAt
                      ? dateFormatter.format(post.data.publishedAt)
                      : 'Recently added'}
                  </span>
                </div>
                <h3 class="d1-prod-title">{post.data.productName ?? post.data.title}</h3>
                <p class="d1-prod-desc">{post.data.description}</p>
              </div>
              <div class="d1-prod-arrow" aria-hidden="true">&#8594;</div>
            </a>
          ))}
          <div class="d1-quote-banner" aria-hidden="true">
            <h3 class="d1-quote-text">Good skin is a long-term relationship.</h3>
            <span class="d1-quote-rule" aria-hidden="true"></span>
            <p class="d1-quote-footer">SAME PRODUCTS. A CALMER YOU.</p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- BOTTOM: Compare + Finished & Bought Again -->
  <div class="d1-wrap d1-bottom-grid">
    <div class="d1-compare-banner">
      <div class="d1-compare-left">
        <h3 class="d1-compare-title">Compare Products</h3>
        <p class="d1-compare-desc">See how your top picks stack up side by side.</p>
        <a class="d1-btn-dark" href="/reviews/">Start a Comparison &rarr;</a>
      </div>
      <div class="d1-compare-visual">
        <div class="d1-bottle-placeholder"></div>
        <div class="d1-vs-circle">VS</div>
        <div class="d1-bottle-placeholder"></div>
      </div>
    </div>

    <div class="d1-latest-box">
      <div class="d1-latest-header">
        <h3 class="d1-latest-title">Finished &amp; Bought Again</h3>
        <a class="d1-latest-viewall" href="/repurchased/">View All &rarr;</a>
      </div>
      <div class="d1-latest-list">
        {finishedPosts.length > 0 ? (
          finishedPosts.map((post) => (
            <a class="d1-latest-item" href={getPostUrl(post)}>
              {post.data.heroImage && (
                <div class="d1-latest-thumb">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt ?? `${post.data.productName ?? post.data.title} product photo`}
                    loading="lazy"
                  />
                </div>
              )}
              <div>
                <div class="d1-latest-item-title">{post.data.productName ?? post.data.title}</div>
                <div class="d1-finished-desc">{post.data.description}</div>
              </div>
            </a>
          ))
        ) : (
          <p class="d1-empty-notes d1-empty-notes-compact">No repurchase notes published yet.</p>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const tablist = document.querySelector('[role="tablist"][aria-label="Latest notes categories"]');
  const tabs = [...document.querySelectorAll('[data-home-tab]')];
  const panels = [...document.querySelectorAll('[data-home-panel]')];
  const viewAll = document.querySelector('[data-home-view-all]');

  function selectTab(next) {
    const id = next.dataset.homeTab;
    if (!id) return;

    tabs.forEach((tab) => {
      const selected = tab === next;
      tab.classList.toggle('d1-tab-active', selected);
      tab.setAttribute('aria-selected', selected ? 'true' : 'false');
      tab.tabIndex = selected ? 0 : -1;
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.homePanel !== id;
    });

    if (viewAll && next.dataset.viewHref) {
      viewAll.href = next.dataset.viewHref;
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => selectTab(tab));
  });

  tablist?.addEventListener('keydown', (event) => {
    const currentIndex = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
    if (currentIndex < 0) return;

    let nextIndex = currentIndex;
    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
      nextIndex = (currentIndex + 1) % tabs.length;
    } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
      nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
    } else if (event.key === 'Home') {
      nextIndex = 0;
    } else if (event.key === 'End') {
      nextIndex = tabs.length - 1;
    } else {
      return;
    }

    event.preventDefault();
    const next = tabs[nextIndex];
    if (!next) return;
    selectTab(next);
    next.focus();
  });
</script>

<style is:global>
  /* ===== TOKENS ===== */
  :root {
    --d1-bg: #FFFFFF;
    --d1-card: #FFFFFF;
    --d1-subtle: #F3F3F0;
    --d1-profile: #F7F5F1;
    --d1-ink: #1A1A1A;
    --d1-ink2: #4A4A4A;
    --d1-muted: #8A8A8A;
    --d1-line: #E8E8E4;
    --d1-line2: #F0F0EC;
    --d1-terra: #A64B2A;
    --d1-terra-h: #8D3C1F;
    --d1-sage: #2F4F38;
    --d1-sage-l: #E7EFE9;
    --d1-serif: "Playfair Display", "Newsreader", Georgia, serif;
    --d1-sans: "Plus Jakarta Sans", system-ui, sans-serif;
    --d1-ease: cubic-bezier(0.16,1,0.3,1);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-font-smoothing: antialiased; scroll-behavior: smooth; }

  /* Homepage canvas must beat global.css ivory body/header (same-specificity order regression). */
  html body {
    margin: 0;
    background: var(--d1-bg); /* #FFFFFF */
    color: var(--d1-ink);
    font-family: var(--d1-sans);
    font-size: 1rem;
    line-height: 1.65;
  }
  a { color:inherit; text-decoration:none; }
  img { max-width:100%; height:auto; }

  /* ===== LAYOUT ===== */
  .d1-wrap {
    width: min(96rem, calc(100% - 4rem));
    margin-inline: auto;
  }

  /* ===== HEADER (homepage visual overrides; layout/responsive live in global.css) ===== */
  html body .site-header {
    background: var(--d1-bg); /* pure white #FFFFFF */
    border-bottom: 1px solid var(--d1-line2);
  }
  .header-inner {
    width: min(96rem, calc(100% - 4rem));
    margin-inline: auto;
  }
  .logo {
    font-size: 1.7rem;
  }
  .logo-leaf { font-size:1rem; }
  .nav-links a {
    font-size: 0.9rem;
  }
  .header-search-desktop {
    background: var(--d1-card);
    border-color: var(--d1-line);
    color: var(--d1-muted);
    width: 13rem;
    font-size: 0.82rem;
  }
  .btn-header-journal {
    background: var(--d1-sage);
  }
  .btn-header-journal:hover { background:#1e3825; }
  html body .site-nav {
    background: var(--d1-bg); /* keep compact menu white on homepage */
  }

  /* ===== HERO ===== */
  .d1-hero {
    padding: 1.25rem 0 1.05rem;
    background: var(--d1-profile); /* ivory #F7F5F1 — section only */
    border-bottom: 1px solid var(--d1-line2);
  }
  .d1-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 5vw, 5rem);
    align-items: center;
  }
  .d1-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--d1-muted);
    color: var(--d1-sage);
    margin: 0 0 1rem;
  }
  .d1-hero-title {
    font-family: var(--d1-serif);
    font-size: clamp(3rem, 4.2vw, 4.15rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.035em;
    margin: 0 0 1rem;
    color: var(--d1-ink);
  }
  .d1-hero-desc {
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.08rem;
    color: var(--d1-ink2);
    line-height: 1.65;
    margin: 0 0 1.3rem;
    max-width: 27rem;
  }
  .d1-btn-terra {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--d1-terra);
    color: #fff !important;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.72rem 1.55rem;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(166,75,42,0.25);
    transition: all 0.25s var(--d1-ease);
  }
  .d1-btn-terra:hover { background:var(--d1-terra-h); transform:translateY(-2px); }
  .d1-hero-subline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--d1-muted);
  }
  .d1-subline-dash { display:inline-block; width:2rem; height:1px; background:var(--d1-muted); }

  /* Hero texture video */
  .d1-media-box {
    background: #d9d6ce;
    border-radius: 13px;
    aspect-ratio: 2.05 / 1;
    padding: 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 8px 24px rgba(25,27,26,0.08);
    overflow: hidden;
  }
  .d1-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .d1-media-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20,24,20,0.15), transparent 52%, rgba(20,24,20,0.08));
    pointer-events: none;
  }
  .d1-media-script {
    position: relative;
    z-index: 2;
    font-family: var(--d1-serif);
    font-style: italic;
    font-size: 1.6rem;
    color: rgba(255,255,255,0.9);
    line-height: 1.25;
    margin: 0;
  }
  .d1-media-corner-tag {
    position: absolute;
    top: 2rem;
    right: 2rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
    text-align: right;
    line-height: 1.5;
    z-index: 2;
  }
  .d1-media-bottom-tag {
    position: relative;
    z-index: 2;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
  }

  /* ===== SKIN PROFILE BAR ===== */
  .d1-profile-bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: var(--d1-profile);
    border: 1px solid #EFEBE4;
    border-radius: 14px;
    padding: 1.5rem 2rem;
    margin: 1.15rem 0 1.35rem;
    box-shadow: 0 2px 8px rgba(25,27,26,0.04);
  }
  .d1-profile-brand {
    border-right: 1px solid var(--d1-line);
    padding-right: 2rem;
    flex-shrink: 0;
  }
  .d1-profile-title {
    font-family: var(--d1-serif);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 0.2rem;
    color: var(--d1-ink);
  }
  .d1-profile-tagline {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--d1-muted);
    margin: 0;
  }
  .d1-profile-items {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex: 1;
    flex-wrap: wrap;
  }
  .d1-profile-item { display:flex; align-items:flex-start; gap:0.75rem; }
  .d1-profile-icon { font-size:1.35rem; line-height:1; margin-top:0.1rem; }
  .d1-profile-item-label { font-size:0.875rem; font-weight:700; color:var(--d1-ink); }
  .d1-profile-item-value { font-size:0.78rem; color:var(--d1-muted); line-height:1.4; }
  .d1-profile-btn {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--d1-ink2);
    border: 1px solid var(--d1-line);
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .d1-profile-btn:hover { background:var(--d1-subtle); color:var(--d1-ink); }

  /* ===== LATEST NOTES SECTION HEAD ===== */
  .d1-latest-section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--d1-line);
    margin-bottom: 0.35rem;
    min-width: 0;
    flex-wrap: wrap;
  }
  .d1-latest-section-title {
    font-family: var(--d1-serif);
    font-size: 1.65rem;
    font-weight: 600;
    margin: 0;
    padding: 0.85rem 0;
    color: var(--d1-sage);
    border-bottom: 2px solid var(--d1-sage);
    margin-bottom: -1px;
  }
  .d1-latest-section-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.85rem;
    min-width: 0;
  }

  /* ===== TAB BAR ===== */
  .d1-cards-section { margin-bottom: 2rem; min-width: 0; }
  .d1-tab-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--d1-line);
    margin-bottom: 2rem;
    padding-bottom: 0;
    min-width: 0;
    flex-wrap: nowrap;
  }
  .d1-tabs {
    display: flex;
    gap: 2rem;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .d1-tab {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    font: inherit;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--d1-muted);
    padding: 0.85rem 0;
    cursor: pointer;
    margin-bottom: -1px;
    transition: color 0.2s;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .d1-tab:focus-visible {
    outline: 2px solid var(--d1-terra);
    outline-offset: 3px;
  }
  .d1-tab-active {
    color: var(--d1-sage);
    border-bottom-color: var(--d1-sage);
  }
  .d1-tab-right-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--d1-muted);
  }
  .d1-home-panel { min-width: 0; }
  .d1-empty-notes {
    margin: 0;
    padding: 1.5rem 0 0.5rem;
    color: var(--d1-muted);
    font-size: 0.95rem;
  }
  .d1-empty-notes-compact {
    padding: 0.5rem 0 0;
    font-size: 0.85rem;
  }

  /* ===== CARDS GRID (4 notes + 1 quote) ===== */
  .d1-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(0, 0.82fr);
    gap: 1.25rem;
  }
  .d1-prod-card {
    background: var(--d1-card);
    border: 1px solid var(--d1-line);
    border-radius: 14px;
    padding: 0;
    display: flex;
    flex-direction: column;
