---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostUrl, getPublishedPosts } from '../lib/posts';
import { site } from '../site';

const latestPosts = (await getPublishedPosts()).slice(0, 3);
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
const noteLabels: Record<string, string> = {
  reviews: 'Review Note',
  breakouts: 'Skin Note',
  comparisons: 'Comparison Note',
  routines: 'Routine Note',
  ingredients: 'Ingredient Column',
  trends: 'Trend Column',
  'beyond-k-beauty': 'Beauty Note',
};
---

<BaseLayout
  title={site.name}
  description={site.tagline}
  canonicalPath="/"
>
  <!-- HERO: 2-column split -->
  <section class="d1-hero">
    <div class="d1-wrap d1-hero-grid">
      <!-- Left: Text -->
      <div class="d1-hero-left">
        <p class="d1-kicker">REAL TESTS. REAL SKIN. A CALMER TRUTH.</p>
        <h1 class="d1-hero-title">Tested on sensitive<br/>skin. Told honestly.</h1>
        <p class="d1-hero-desc">
          A personal, evidence-in-use journal for K-beauty.
          Thoughtful tests, real-life results, and what I'd actually buy again.
        </p>
        <a class="d1-btn-terra" href="/about/">Explore My Journal &rarr;</a>
        <p class="d1-hero-subline">
          <span class="d1-subline-dash"></span>
          SAME SKIN &nbsp;/&nbsp; MORE ANSWERS &nbsp;/&nbsp; KINDER BEAUTY
        </p>
      </div>
      <!-- Right: real texture footage -->
      <div class="d1-hero-right">
        <div class="d1-media-box">
          <video class="d1-hero-video" autoplay loop muted playsinline preload="metadata" aria-label="A close look at skincare serum texture being spread across the back of a hand">
            <source src="/media/products/torriden-dive-in-serum/spreading.mp4" type="video/mp4" />
          </video>
          <div class="d1-media-shade"></div>
          <p class="d1-media-script">Same skin.<br/>More truth.</p>
          <span class="d1-media-corner-tag">TEXTURES TELL<br/>STORIES TOO.</span>
          <span class="d1-media-bottom-tag">REAL TEXTURE &middot; NO FILTER</span>
        </div>
      </div>
    </div>
  </section>

  <!-- MY SKIN PROFILE BAR -->
  <div class="d1-wrap">
    <div class="d1-profile-bar">
      <div class="d1-profile-brand">
        <h2 class="d1-profile-title">My Skin Profile</h2>
        <p class="d1-profile-tagline">BECAUSE CONTEXT MATTERS</p>
      </div>
      <div class="d1-profile-items">
        <div class="d1-profile-item">
          <span class="d1-profile-icon">🌿</span>
          <div>
            <div class="d1-profile-item-label">Dry + Somewhat Sensitive</div>
            <div class="d1-profile-item-value">Dry skin that can occasionally react</div>
          </div>
        </div>
        <div class="d1-profile-item">
          <span class="d1-profile-icon">☀️</span>
          <div>
            <div class="d1-profile-item-label">Main Concerns</div>
            <div class="d1-profile-item-value">Dryness, dehydration, early signs of aging</div>
          </div>
        </div>
        <div class="d1-profile-item">
          <span class="d1-profile-icon">💧</span>
          <div>
            <div class="d1-profile-item-label">Skin Goals</div>
            <div class="d1-profile-item-value">Hydration, barrier support, healthy-looking skin</div>
          </div>
        </div>
      </div>
      <a class="d1-profile-btn" href="/about/">Edit Profile &rarr;</a>
    </div>
  </div>

  <!-- TABS + CARDS SECTION -->
  <div class="d1-wrap d1-cards-section">
    <!-- Tab Bar -->
    <div class="d1-tab-bar">
      <div class="d1-tabs">
        <span class="d1-tab d1-tab-active">Repurchased</span>
        <span class="d1-tab">What Didn’t Work</span>
        <span class="d1-tab">Routines</span>
      </div>
      <span class="d1-tab-right-label">REAL EXPERIENCE. REPEAT WORTHY.</span>
    </div>

    <!-- 4 Product Cards + 1 Quote Banner -->
    <div class="d1-cards-grid">
      <!-- Card 1 -->
      <a class="d1-prod-card" href="/reviews/vt-cica-reedle-shot-100/">
        <div class="d1-prod-body">
          <div class="d1-prod-meta-row">
            <span class="d1-prod-kicker">CALMS MY SKIN</span>
            <span>🌿</span>
          </div>
          <h3 class="d1-prod-title">VT CICA Reedle Shot 100</h3>
          <p class="d1-prod-desc">Absorption-boosting serum. Finished one bottle and repurchased — my skin texture improved noticeably.</p>
        </div>
        <div class="d1-prod-arrow">&#8594;</div>
      </a>

      <!-- Card 2 -->
      <a class="d1-prod-card" href="/about/">
        <div class="d1-prod-body">
          <div class="d1-prod-meta-row">
            <span class="d1-prod-kicker">ALWAYS A REORDER</span>
            <span>🌿</span>
          </div>
          <h3 class="d1-prod-title">AESTURA ATOBARRIER365 Cream</h3>
          <p class="d1-prod-desc">Reliable ceramide barrier cream. My skin feels steadier whenever I use this consistently.</p>
        </div>
        <div class="d1-prod-arrow">&#8594;</div>
      </a>

      <!-- Card 3 -->
      <a class="d1-prod-card" href="/reviews/mixsoon-galactomyces-toner/">
        <div class="d1-prod-img">
          <img src="/media/products/mixsoon-galactomyces-toner/front.jpg" alt="mixsoon Galactomyces Toner held in hand" loading="lazy" />
        </div>
        <div class="d1-prod-body">
          <div class="d1-prod-meta-row">
            <span class="d1-prod-kicker">SOOTHES & SUPPORTS</span>
            <span>🌿</span>
          </div>
          <h3 class="d1-prod-title">mixsoon Galactomyces Toner</h3>
          <p class="d1-prod-desc">Watery, quick to absorb, and comfortable enough that I am already on my second bottle.</p>
        </div>
        <div class="d1-prod-arrow">&#8594;</div>
      </a>

      <!-- Card 4 -->
      <a class="d1-prod-card" href="/reviews/torriden-dive-in-serum/">
        <div class="d1-prod-img">
          <img src="/media/products/torriden-dive-in-serum/front.jpg" alt="Half-used Torriden DIVE-IN Serum bottle held in hand" loading="lazy" />
        </div>
        <div class="d1-prod-body">
          <div class="d1-prod-meta-row">
            <span class="d1-prod-kicker">REPLENISHES WELL</span>
            <span>🌿</span>
          </div>
          <h3 class="d1-prod-title">Torriden DIVE-IN Serum</h3>
          <p class="d1-prod-desc">Light, fast-absorbing hydration that helps my dry skin stay comfortable beneath makeup.</p>
        </div>
        <div class="d1-prod-arrow">&#8594;</div>
      </a>

      <!-- 5th: Editorial Quote Banner -->
      <div class="d1-quote-banner">
        <h3 class="d1-quote-text">Good skin is a long-term relationship.</h3>
        <span class="d1-quote-rule" aria-hidden="true"></span>
        <p class="d1-quote-footer">SAME PRODUCTS. A CALMER YOU.</p>
      </div>
    </div>
  </div>

  <!-- BOTTOM: Compare + Latest Notes -->
  <div class="d1-wrap d1-bottom-grid">
    <div class="d1-compare-banner">
      <div class="d1-compare-left">
        <h3 class="d1-compare-title">Compare Products</h3>
        <p class="d1-compare-desc">See how your top picks stack up side by side.</p>
        <a class="d1-btn-dark" href="/reviews/">Start a Comparison &rarr;</a>
      </div>
      <div class="d1-compare-visual">
        <div class="d1-bottle-placeholder"></div>
        <div class="d1-vs-circle">VS</div>
        <div class="d1-bottle-placeholder"></div>
      </div>
    </div>

    <div class="d1-latest-box">
      <div class="d1-latest-header">
        <h3 class="d1-latest-title">Latest Notes</h3>
        <a class="d1-latest-viewall" href="/reviews/">View All &rarr;</a>
      </div>
      <div class="d1-latest-list">
        {latestPosts.map((post) => (
          <a class="d1-latest-item" href={getPostUrl(post)}>
            <div class:list={['d1-latest-thumb', { 'd1-latest-thumb-empty': !post.data.heroImage }]}>
              {post.data.heroImage ? (
                <img
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt ?? `${post.data.productName ?? post.data.title} product photo`}
                  loading="lazy"
                />
              ) : (
                <span aria-hidden="true">{(post.data.productName ?? post.data.title).slice(0, 2).toUpperCase()}</span>
              )}
            </div>
            <div>
              <div class="d1-latest-item-title">{post.data.productName ?? post.data.title}</div>
              <div class="d1-latest-meta">
                {post.data.publishedAt ? dateFormatter.format(post.data.publishedAt) : 'Recently added'}
                &nbsp;&bull;&nbsp; {noteLabels[post.data.category] ?? 'Journal Note'}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* ===== TOKENS ===== */
  :root {
    --d1-bg: #FFFFFF;
    --d1-card: #FFFFFF;
    --d1-subtle: #F3F3F0;
    --d1-profile: #F7F5F1;
    --d1-ink: #1A1A1A;
    --d1-ink2: #4A4A4A;
    --d1-muted: #8A8A8A;
    --d1-line: #E8E8E4;
    --d1-line2: #F0F0EC;
    --d1-terra: #A64B2A;
    --d1-terra-h: #8D3C1F;
    --d1-sage: #2F4F38;
    --d1-sage-l: #E7EFE9;
    --d1-serif: "Playfair Display", "Newsreader", Georgia, serif;
    --d1-sans: "Plus Jakarta Sans", system-ui, sans-serif;
    --d1-ease: cubic-bezier(0.16,1,0.3,1);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-font-smoothing: antialiased; scroll-behavior: smooth; }
  body { margin:0; background:var(--d1-bg); color:var(--d1-ink); font-family:var(--d1-sans); font-size:1rem; line-height:1.65; }
  a { color:inherit; text-decoration:none; }
  img { max-width:100%; height:auto; }

  /* ===== LAYOUT ===== */
  .d1-wrap {
    width: min(96rem, calc(100% - 4rem));
    margin-inline: auto;
  }

  /* ===== HEADER (homepage visual overrides; layout/responsive live in global.css) ===== */
  .site-header {
    background: rgba(255,255,255,0.96);
    border-bottom: 1px solid var(--d1-line2);
  }
  .header-inner {
    width: min(96rem, calc(100% - 4rem));
    margin-inline: auto;
  }
  .logo {
    font-size: 1.7rem;
  }
  .logo-leaf { font-size:1rem; }
  .nav-links a {
    font-size: 0.9rem;
  }
  .header-search-desktop {
    background: var(--d1-card);
    border-color: var(--d1-line);
    color: var(--d1-muted);
    width: 13rem;
    font-size: 0.82rem;
  }
  .btn-header-journal {
    background: var(--d1-sage);
  }
  .btn-header-journal:hover { background:#1e3825; }
  .site-nav {
    background: rgba(255,255,255,0.98);
  }

  /* ===== HERO ===== */
  .d1-hero {
    padding: 1.25rem 0 1.05rem;
    background: var(--d1-profile);
    border-bottom: 1px solid var(--d1-line2);
  }
  .d1-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 5vw, 5rem);
    align-items: center;
  }
  .d1-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--d1-muted);
    color: var(--d1-sage);
    margin: 0 0 1rem;
  }
  .d1-hero-title {
    font-family: var(--d1-serif);
    font-size: clamp(3rem, 4.2vw, 4.15rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.035em;
    margin: 0 0 1rem;
    color: var(--d1-ink);
  }
  .d1-hero-desc {
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.08rem;
    color: var(--d1-ink2);
    line-height: 1.65;
    margin: 0 0 1.3rem;
    max-width: 27rem;
  }
  .d1-btn-terra {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--d1-terra);
    color: #fff !important;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.72rem 1.55rem;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(166,75,42,0.25);
    transition: all 0.25s var(--d1-ease);
  }
  .d1-btn-terra:hover { background:var(--d1-terra-h); transform:translateY(-2px); }
  .d1-hero-subline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--d1-muted);
  }
  .d1-subline-dash { display:inline-block; width:2rem; height:1px; background:var(--d1-muted); }

  /* Hero texture video */
  .d1-media-box {
    background: #d9d6ce;
    border-radius: 13px;
    aspect-ratio: 2.05 / 1;
    padding: 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 8px 24px rgba(25,27,26,0.08);
    overflow: hidden;
  }
  .d1-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .d1-media-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20,24,20,0.15), transparent 52%, rgba(20,24,20,0.08));
    pointer-events: none;
  }
  .d1-media-script {
    position: relative;
    z-index: 2;
    font-family: var(--d1-serif);
    font-style: italic;
    font-size: 1.6rem;
    color: rgba(255,255,255,0.9);
    line-height: 1.25;
    margin: 0;
  }
  .d1-media-corner-tag {
    position: absolute;
    top: 2rem;
    right: 2rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
    text-align: right;
    line-height: 1.5;
    z-index: 2;
  }
  .d1-media-bottom-tag {
    position: relative;
    z-index: 2;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
  }

  /* ===== SKIN PROFILE BAR ===== */
  .d1-profile-bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: var(--d1-profile);
    border: 1px solid #EFEBE4;
    border-radius: 14px;
    padding: 1.5rem 2rem;
    margin: 1.15rem 0 1.35rem;
    box-shadow: 0 2px 8px rgba(25,27,26,0.04);
  }
  .d1-profile-brand {
    border-right: 1px solid var(--d1-line);
    padding-right: 2rem;
    flex-shrink: 0;
  }
  .d1-profile-title {
    font-family: var(--d1-serif);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 0.2rem;
    color: var(--d1-ink);
  }
  .d1-profile-tagline {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--d1-muted);
    margin: 0;
  }
  .d1-profile-items {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex: 1;
    flex-wrap: wrap;
  }
  .d1-profile-item { display:flex; align-items:flex-start; gap:0.75rem; }
  .d1-profile-icon { font-size:1.35rem; line-height:1; margin-top:0.1rem; }
  .d1-profile-item-label { font-size:0.875rem; font-weight:700; color:var(--d1-ink); }
  .d1-profile-item-value { font-size:0.78rem; color:var(--d1-muted); line-height:1.4; }
  .d1-profile-btn {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--d1-ink2);
    border: 1px solid var(--d1-line);
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .d1-profile-btn:hover { background:var(--d1-subtle); color:var(--d1-ink); }

  /* ===== TAB BAR ===== */
  .d1-cards-section { margin-bottom: 2rem; min-width: 0; }
  .d1-tab-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--d1-line);
    margin-bottom: 2rem;
    padding-bottom: 0;
    min-width: 0;
    flex-wrap: wrap;
  }
  .d1-tabs {
    display: flex;
    gap: 2rem;
    min-width: 0;
    max-width: 100%;
  }
  .d1-tab {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--d1-muted);
    padding: 0.85rem 0;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.2s;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .d1-tab:focus-visible {
    outline: 2px solid var(--d1-terra);
    outline-offset: 3px;
  }
  .d1-tab-active {
    color: var(--d1-sage);
    border-bottom-color: var(--d1-sage);
  }
  .d1-tab-right-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--d1-muted);
  }

  /* ===== CARDS GRID (4 product + 1 quote) ===== */
  .d1-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(0, 0.82fr);
    gap: 1.25rem;
  }
  .d1-prod-card {
    background: var(--d1-card);
    border: 1px solid var(--d1-line);
    border-radius: 14px;
    padding: 0;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(25,27,26,0.04);
    transition: transform 0.28s var(--d1-ease), box-shadow 0.28s var(--d1-ease);
    cursor: pointer;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }
  .d1-prod-card:hover { transform:translateY(-5px); box-shadow:0 12px 28px rgba(25,27,26,0.09); }
  .d1-prod-img {
    background: var(--d1-subtle);
    aspect-ratio: 1.05;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
    flex-shrink: 0;
  }
  .d1-prod-img-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--d1-muted);
    text-align: center;
    padding: 0.5rem;
  }
  .d1-prod-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .d1-prod-body {
    flex: 1;
    padding: 1rem 1rem 3.4rem;
    min-width: 0;
  }
  .d1-prod-card:not(:has(.d1-prod-img)) .d1-prod-body {
    padding-top: 1.15rem;
  }
  .d1-prod-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .d1-prod-kicker {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--d1-muted);
  }
  .d1-prod-title {
    font-family: var(--d1-serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.45rem;
    color: var(--d1-ink);
    transition: color 0.2s;
  }
  .d1-prod-card:hover .d1-prod-title { color:var(--d1-sage); }
  .d1-prod-desc {
    font-size: 0.8rem;
    color: var(--d1-ink2);
    line-height: 1.5;
    margin: 0;
  }
  .d1-prod-arrow {
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--d1-terra);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    transition: transform 0.2s;
  }
  .d1-prod-card:hover .d1-prod-arrow { transform:scale(1.1); }

  /* Quote Banner (5th column) */
  .d1-quote-banner {
    background:
      linear-gradient(180deg, rgba(255,255,255,0.02), rgba(244,236,222,0.08)),
      url('/media/editorial/good-skin-quote-bg.webp') center / cover no-repeat;
    border-radius: 14px;
    padding: 2.1rem 1.35rem 1.65rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-shadow: 0 2px 8px rgba(25,27,26,0.04);
    overflow: hidden;
    min-height: 100%;
  }
  .d1-quote-text {
    font-family: var(--d1-serif);
    font-size: clamp(1.35rem, 1.55vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--d1-ink);
    margin: 0;
    max-width: 9ch;
  }
  .d1-quote-rule {
    display: block;
    width: 2rem;
    height: 1px;
    background: rgba(25,27,26,0.65);
    margin-top: 1.25rem;
  }
  .d1-quote-footer {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(25,27,26,0.5);
    margin: auto 0 0;
    max-width: 11rem;
    line-height: 1.55;
  }

