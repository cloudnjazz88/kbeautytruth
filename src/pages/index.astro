---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getPostUrl,
  getPublishedPosts,
  getRepurchasedPosts,
} from '../lib/posts';
import { formatShortDate } from '../lib/dates';
import { site } from '../site';

const publishedPosts = await getPublishedPosts();
const finishedPosts = (await getRepurchasedPosts()).slice(0, 3);
const compareHref = '/comparisons/torriden-dive-in-soothing-cream-vs-aestura-atobarrier365-cream/';
const compareProducts = [
  publishedPosts.find((post) => post.data.slug === 'torriden-dive-in-soothing-cream'),
  publishedPosts.find((post) => post.data.slug === 'aestura-atobarrier365-cream-review'),
].filter((post): post is NonNullable<typeof post> => Boolean(post));
const reviewPosts = publishedPosts
  .filter((post) => post.data.category === 'reviews')
  .slice(0, 7);
const showReviewNav = reviewPosts.length > 4;
const ingredientPosts = publishedPosts
  .filter((post) => post.data.category === 'ingredients')
  .slice(0, 2);
const trendPosts = publishedPosts
  .filter((post) => post.data.category === 'trends')
  .slice(0, 2);
const columnTypeLabel: Record<'ingredients' | 'trends', string> = {
  ingredients: 'Ingredient',
  trends: 'Trend',
};
---

<BaseLayout
  title={site.name}
  description={site.tagline}
  canonicalPath="/"
>
  <!-- HERO: 2-column split -->
  <section class="d1-hero">
    <div class="d1-wrap d1-hero-grid">
      <!-- Left: Text -->
      <div class="d1-hero-left">
        <p class="d1-kicker">REAL TESTS. REAL SKIN. A CALMER TRUTH.</p>
        <h1 class="d1-hero-title">Tested on sensitive<br/>skin. Told honestly.</h1>
        <p class="d1-hero-desc">
          A personal, evidence-in-use journal for K-beauty.
          Thoughtful tests, real-life results, and what I'd actually buy again.
        </p>
        <a class="d1-btn-terra" href="/about/">Explore My Journal &rarr;</a>
        <p class="d1-hero-subline">
          <span class="d1-subline-dash"></span>
          SAME SKIN &nbsp;/&nbsp; MORE ANSWERS &nbsp;/&nbsp; KINDER BEAUTY
        </p>
      </div>
      <!-- Right: real texture footage -->
      <div class="d1-hero-right">
        <div class="d1-media-box">
          <video class="d1-hero-video" autoplay loop muted playsinline preload="metadata" poster="/media/editorial/kbeautytruth-hero-6s-poster.jpg" aria-label="A close look at skincare serum texture being spread across the back of a hand">
            <source src="/media/editorial/kbeautytruth-hero-6s.mp4" type="video/mp4" />
          </video>
          <div class="d1-media-shade"></div>
          <p class="d1-media-script">Same skin.<br/>More truth.</p>
          <span class="d1-media-corner-tag">TEXTURES TELL<br/>STORIES TOO.</span>
          <span class="d1-media-bottom-tag">REAL TEXTURE &middot; NO FILTER</span>
        </div>
      </div>
    </div>
  </section>

  <!-- MY SKIN PROFILE BAR -->
  <div class="d1-wrap">
    <div class="d1-profile-bar">
      <div class="d1-profile-brand">
        <h2 class="d1-profile-title">My Skin Profile</h2>
        <p class="d1-profile-tagline">BECAUSE CONTEXT MATTERS</p>
      </div>
      <div class="d1-profile-items">
        <div class="d1-profile-item">
          <span class="d1-profile-icon">🌿</span>
          <div>
            <div class="d1-profile-item-label">Dry + Somewhat Sensitive</div>
            <div class="d1-profile-item-value">Dry skin that can occasionally react</div>
          </div>
        </div>
        <div class="d1-profile-item">
          <span class="d1-profile-icon">☀️</span>
          <div>
            <div class="d1-profile-item-label">Main Concerns</div>
            <div class="d1-profile-item-value">Dryness, dehydration, early signs of aging</div>
          </div>
        </div>
        <div class="d1-profile-item">
          <span class="d1-profile-icon">💧</span>
          <div>
            <div class="d1-profile-item-label">Skin Goals</div>
            <div class="d1-profile-item-value">Hydration, barrier support, healthy-looking skin</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- LATEST NOTES -->
  <div class="d1-wrap d1-cards-section">
    <div class="d1-latest-section-head">
      <h2 class="d1-latest-section-title">Latest Notes</h2>
      <div class="d1-latest-section-meta">
        <span class="d1-section-eyebrow">NEW NOTES, HONESTLY DOCUMENTED.</span>
      </div>
    </div>

    <div class="d1-notes-row" data-reviews-row>
      {reviewPosts.length === 0 && (
        <>
          <div class="d1-notes-row-head">
            <h3 class="d1-notes-row-title">Reviews</h3>
            <a class="d1-latest-viewall" href="/reviews/">View All &rarr;</a>
          </div>
          <p class="d1-empty-notes">No product reviews published yet.</p>
        </>
      )}
      {
        reviewPosts.length > 0 && (
          <div class="d1-cards-grid d1-cards-grid-controls">
            <div class="d1-reviews-control-row">
              <div class="d1-reviews-control-main">
                <h3 class="d1-notes-row-title d1-reviews-heading">Reviews</h3>
                {
                  showReviewNav && (
                    <div class="d1-reviews-toolbar" data-reviews-nav>
                      <p class="d1-reviews-eyebrow">REAL USE. HONEST NOTES.</p>
                      <div class="d1-reviews-nav">
                        <button
                          type="button"
                          class="d1-reviews-nav-btn"
                          data-reviews-prev
                          aria-label="Previous reviews"
                          disabled
                        >
                          <span aria-hidden="true">←</span>
                        </button>
                        <button
                          type="button"
                          class="d1-reviews-nav-btn"
                          data-reviews-next
                          aria-label="Next reviews"
                        >
                          <span aria-hidden="true">→</span>
                        </button>
                      </div>
                    </div>
                  )
                }
              </div>
              <a class="d1-latest-viewall d1-reviews-viewall" href="/reviews/">View All &rarr;</a>
            </div>
            <div
              class="d1-reviews-carousel"
              data-reviews-carousel
              data-review-count={String(reviewPosts.length)}
            >
              <div class="d1-reviews-track" data-reviews-track>
                {reviewPosts.map((post) => (
                  <a class="d1-prod-card" href={getPostUrl(post)}>
                    {post.data.heroImage && (
                      <div class="d1-prod-img">
                        <img
                          src={post.data.heroImage}
                          alt={post.data.heroImageAlt ?? `${post.data.productName ?? post.data.title} product photo`}
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="d1-prod-body">
                      <div class="d1-prod-meta-row">
                        <span class="d1-prod-kicker">Review Note</span>
                        <span class="d1-prod-date">
                          {post.data.publishedAt
                            ? formatShortDate(post.data.publishedAt)
                            : 'Recently added'}
                        </span>
                      </div>
                      <h3 class="d1-prod-title">{post.data.productName ?? post.data.title}</h3>
                      <p class="d1-prod-desc">{post.data.description}</p>
                    </div>
                    <div class="d1-prod-arrow" aria-hidden="true">&#8594;</div>
                  </a>
                ))}
              </div>
            </div>
            <div class="d1-quote-banner" aria-hidden="true">
              <h3 class="d1-quote-text">Good skin is a long-term relationship.</h3>
              <span class="d1-quote-rule" aria-hidden="true"></span>
              <p class="d1-quote-footer">SAME PRODUCTS. A CALMER YOU.</p>
            </div>
          </div>
        )
      }
    </div>
    {
      reviewPosts.length > 0 && (
        <script is:inline>
          (function initReviewsCarousel() {
            const row = document.querySelector('[data-reviews-row]');
            if (!row) return;
            const carousel = row.querySelector('[data-reviews-carousel]');
            const track = row.querySelector('[data-reviews-track]');
            const prev = row.querySelector('[data-reviews-prev]');
            const next = row.querySelector('[data-reviews-next]');
            const nav = row.querySelector('[data-reviews-nav]');
            if (!carousel || !track) return;

            const cards = Array.prototype.slice.call(track.querySelectorAll('.d1-prod-card'));
            const total = cards.length;
            let start = 0;

            function visibleCount() {
              if (window.matchMedia('(max-width: 768px)').matches) return 1;
              if (window.matchMedia('(max-width: 1199px)').matches) return 2;
              return 4;
            }

            function maxStart() {
              return Math.max(0, total - visibleCount());
            }

            function apply() {
              const visible = visibleCount();
              const max = maxStart();
              if (start > max) start = max;
              if (start < 0) start = 0;

              const styles = getComputedStyle(track);
              const gap = parseFloat(styles.columnGap || styles.gap) || 0;
              const carouselWidth = carousel.clientWidth;
              const cardWidth = Math.max(0, (carouselWidth - (visible - 1) * gap) / visible);

              cards.forEach(function (card, index) {
                card.style.flex = '0 0 ' + cardWidth + 'px';
                card.style.width = cardWidth + 'px';
                card.style.height = '100%';
                const onScreen = index >= start && index < start + visible;
                if (onScreen) card.removeAttribute('inert');
                else card.setAttribute('inert', '');
              });

              track.style.transform = 'translate3d(' + -(start * (cardWidth + gap)) + 'px, 0, 0)';
              if (prev) prev.disabled = start <= 0;
              if (next) next.disabled = start >= max;
            }

            function go(delta) {
              start += delta;
              apply();
            }

            if (prev && next) {
              prev.addEventListener('click', function () { go(-1); });
              next.addEventListener('click', function () { go(1); });
              if (nav) {
                nav.addEventListener('keydown', function (event) {
                  if (event.key === 'ArrowLeft' && !prev.disabled) {
                    event.preventDefault();
                    go(-1);
                  }
                  if (event.key === 'ArrowRight' && !next.disabled) {
                    event.preventDefault();
                    go(1);
                  }
                });
              }
            }

            window.addEventListener('resize', apply);
            apply();
          })();
        </script>
      )
    }

    <div class="d1-notes-row d1-notes-row-columns">
      {ingredientPosts.length === 0 && trendPosts.length === 0 ? (
        <p class="d1-empty-notes">No ingredient or trend notes published yet.</p>
      ) : (
        <div class="d1-columns-split">
          <div class="d1-column-group">
            <div class="d1-notes-row-head">
              <h3 class="d1-notes-row-title">Ingredients</h3>
              <a class="d1-latest-viewall" href="/ingredients/">View all &rarr;</a>
            </div>
            {ingredientPosts.length > 0 && (
              <div class="d1-column-stack">
                {ingredientPosts.map((post) => (
                  <a class="d1-column-card" href={getPostUrl(post)}>
                    <div class="d1-column-meta">
                      <span class="d1-column-type">{columnTypeLabel.ingredients}</span>
                      <span class="d1-column-date">
                        {post.data.publishedAt
                          ? formatShortDate(post.data.publishedAt)
                          : 'Recently added'}
                      </span>
                    </div>
                    <h3 class="d1-column-title">{post.data.title}</h3>
                    <p class="d1-column-desc">{post.data.description}</p>
                  </a>
                ))}
              </div>
            )}
          </div>
          <div class="d1-column-group">
            <div class="d1-notes-row-head">
              <h3 class="d1-notes-row-title">Trends</h3>
              <a class="d1-latest-viewall" href="/trends/">View all &rarr;</a>
            </div>
            {trendPosts.length > 0 && (
              <div class="d1-column-stack">
                {trendPosts.map((post) => (
                  <a class="d1-column-card" href={getPostUrl(post)}>
                    <div class="d1-column-meta">
                      <span class="d1-column-type">{columnTypeLabel.trends}</span>
                      <span class="d1-column-date">
                        {post.data.publishedAt
                          ? formatShortDate(post.data.publishedAt)
                          : 'Recently added'}
                      </span>
                    </div>
                    <h3 class="d1-column-title">{post.data.title}</h3>
                    <p class="d1-column-desc">{post.data.description}</p>
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- BOTTOM: Compare + Finished & Bought Again -->
  <div class="d1-wrap d1-bottom-grid">
    <div class="d1-compare-banner">
      <div class="d1-compare-left">
        <h3 class="d1-compare-title">Compare Products</h3>
        <p class="d1-compare-desc">
          Torriden DIVE-IN Soothing Cream vs AESTURA ATOBARRIER365 Cream — which Kay reaches for, and when.
        </p>
        <a class="d1-btn-dark" href={compareHref}>Start a Comparison &rarr;</a>
      </div>
      <div class="d1-compare-visual">
        {compareProducts[0] && (
          <a class="d1-compare-product" href={getPostUrl(compareProducts[0])}>
            {compareProducts[0].data.heroImage && (
              <img
                src={compareProducts[0].data.heroImage}
                alt={compareProducts[0].data.heroImageAlt ?? `${compareProducts[0].data.productName ?? compareProducts[0].data.title} product photo`}
                loading="lazy"
              />
            )}
            <span class="d1-compare-product-name">{compareProducts[0].data.productName ?? compareProducts[0].data.title}</span>
          </a>
        )}
        {compareProducts.length > 1 && <div class="d1-vs-circle">VS</div>}
        {compareProducts[1] && (
          <a class="d1-compare-product" href={getPostUrl(compareProducts[1])}>
            {compareProducts[1].data.heroImage && (
              <img
                src={compareProducts[1].data.heroImage}
                alt={compareProducts[1].data.heroImageAlt ?? `${compareProducts[1].data.productName ?? compareProducts[1].data.title} product photo`}
                loading="lazy"
              />
            )}
            <span class="d1-compare-product-name">{compareProducts[1].data.productName ?? compareProducts[1].data.title}</span>
          </a>
        )}
      </div>
    </div>

    <div class="d1-latest-box">
      <div class="d1-latest-header">
        <h3 class="d1-latest-title">Finished &amp; Bought Again</h3>
        <a class="d1-latest-viewall" href="/repurchased/">View All &rarr;</a>
      </div>
      <div class="d1-latest-list">
        {finishedPosts.length > 0 ? (
          finishedPosts.map((post) => (
            <a class="d1-latest-item" href={getPostUrl(post)}>
              {post.data.heroImage && (
                <div class="d1-latest-thumb">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt ?? `${post.data.productName ?? post.data.title} product photo`}
                    loading="lazy"
                  />
                </div>
              )}
              <div>
                <div class="d1-latest-item-title">{post.data.productName ?? post.data.title}</div>
                <div class="d1-finished-desc">{post.data.description}</div>
              </div>
            </a>
          ))
        ) : (
          <p class="d1-empty-notes d1-empty-notes-compact">No repurchase notes published yet.</p>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* ===== TOKENS ===== */
  :root {
    --d1-bg: #FFFFFF;
    --d1-card: #FFFFFF;
    --d1-subtle: #F3F3F0;
    --d1-profile: #F7F5F1;
    --d1-ink: #1A1A1A;
    --d1-ink2: #4A4A4A;
    --d1-muted: #8A8A8A;
    --d1-line: #E8E8E4;
    --d1-line2: #F0F0EC;
    --d1-terra: #A64B2A;
    --d1-terra-h: #8D3C1F;
    --d1-sage: #2F4F38;
    --d1-sage-l: #E7EFE9;
    --d1-serif: "Playfair Display", "Newsreader", Georgia, serif;
    --d1-sans: "Plus Jakarta Sans", system-ui, sans-serif;
    --d1-ease: cubic-bezier(0.16,1,0.3,1);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-font-smoothing: antialiased; scroll-behavior: smooth; }

  /* Homepage canvas must beat global.css ivory body/header (same-specificity order regression). */
  html body {
    margin: 0;
    background: var(--d1-bg); /* #FFFFFF */
    color: var(--d1-ink);
    font-family: var(--d1-sans);
    font-size: 1rem;
    line-height: 1.65;
  }
  a { color:inherit; text-decoration:none; }
  img { max-width:100%; height:auto; }

  /* ===== LAYOUT ===== */
  .d1-wrap {
    width: min(96rem, calc(100% - 4rem));
    margin-inline: auto;
  }

  /* ===== HEADER (homepage visual overrides; layout/responsive live in global.css) ===== */
  html body .site-header {
    background: var(--d1-bg); /* pure white #FFFFFF */
    border-bottom: 1px solid var(--d1-line2);
  }
  .header-inner {
    width: min(96rem, calc(100% - 4rem));
    margin-inline: auto;
  }
  .logo {
    font-size: 1.7rem;
  }
  .logo-leaf { font-size:1rem; }
  .nav-links a {
    font-size: 0.9rem;
  }
  .header-search-desktop {
    background: var(--d1-card);
    border-color: var(--d1-line);
    color: var(--d1-muted);
    width: 13rem;
    font-size: 0.82rem;
  }
  .btn-header-journal {
    background: var(--d1-sage);
  }
  .btn-header-journal:hover { background:#1e3825; }
  html body .site-nav {
    background: var(--d1-bg); /* keep compact menu white on homepage */
  }

  /* ===== HERO ===== */
  .d1-hero {
    padding: 1.25rem 0 1.05rem;
    background: var(--d1-profile); /* ivory #F7F5F1 — section only */
    border-bottom: 1px solid var(--d1-line2);
  }
  .d1-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 5vw, 5rem);
    align-items: center;
  }
  .d1-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--d1-muted);
    color: var(--d1-sage);
    margin: 0 0 1rem;
  }
  .d1-hero-title {
    font-family: var(--d1-serif);
    font-size: clamp(3rem, 4.2vw, 4.15rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.035em;
    margin: 0 0 1rem;
    color: var(--d1-ink);
  }
  .d1-hero-desc {
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.08rem;
    color: var(--d1-ink2);
    line-height: 1.65;
    margin: 0 0 1.3rem;
    max-width: 27rem;
  }
  .d1-btn-terra {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--d1-terra);
    color: #fff !important;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.72rem 1.55rem;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(166,75,42,0.25);
    transition: all 0.25s var(--d1-ease);
  }
  .d1-btn-terra:hover { background:var(--d1-terra-h); transform:translateY(-2px); }
  .d1-hero-subline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--d1-muted);
  }
  .d1-subline-dash { display:inline-block; width:2rem; height:1px; background:var(--d1-muted); }

  /* Hero texture video */
  .d1-media-box {
    background: #d9d6ce;
    border-radius: 13px;
    aspect-ratio: 2.05 / 1;
    padding: 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 8px 24px rgba(25,27,26,0.08);
    overflow: hidden;
  }
  .d1-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* ~8% crop-zoom on the glossy formula, slightly right of center */
    object-position: 60% 50%;
    transform: scale(1.08);
    transform-origin: 60% 50%;
    /* Soft lift so the gel reads as lit, not underexposed */
    filter: var(--media-lift, brightness(1.24) contrast(1.06));
  }
  .d1-media-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20,24,20,0.06), transparent 52%, rgba(20,24,20,0.03));
    pointer-events: none;
  }
  .d1-media-script {
    position: relative;
    z-index: 2;
    font-family: var(--d1-serif);
    font-style: italic;
    font-size: 1.6rem;
    color: rgba(255,255,255,0.9);
    line-height: 1.25;
    margin: 0;
  }
  .d1-media-corner-tag {
    position: absolute;
    top: 2rem;
    right: 2rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
    text-align: right;
    line-height: 1.5;
    z-index: 2;
  }
  .d1-media-bottom-tag {
    position: relative;
    z-index: 2;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
  }

  /* ===== SKIN PROFILE BAR ===== */
  .d1-profile-bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: var(--d1-profile);
    border: 1px solid #EFEBE4;
    border-radius: 14px;
    padding: 1.5rem 2rem;
    margin: 1.15rem 0 1.35rem;
    box-shadow: 0 2px 8px rgba(25,27,26,0.04);
    min-width: 0;
  }
  .d1-profile-brand {
    border-right: 1px solid var(--d1-line);
    padding-right: 2rem;
    flex-shrink: 0;
    max-width: 12.5rem;
  }
  .d1-profile-title {
    font-family: var(--d1-serif);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 0.2rem;
    color: var(--d1-ink);
  }
  .d1-profile-tagline {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--d1-muted);
    margin: 0;
  }
  .d1-profile-items {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.75rem 2.75rem;
    flex: 1;
    min-width: 0;
  }
  .d1-profile-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    flex: 1 1 0;
    min-width: 0;
  }
  .d1-profile-item > div {
