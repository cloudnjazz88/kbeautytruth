---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';
---

<BaseLayout
  title="Privacy Policy"
  description="How K-Beauty Truth handles information on this static site."
  canonicalPath="/privacy/"
>
  <section class="stack-page">
    <div class="wrap prose">
      <h1 class="page-title">Privacy Policy</h1>
      <p>
        {site.name} is a static website. These pages are hosted copies of text and images. This
        policy describes only what is true of the site as it is set up now.
      </p>
      <h2>Information you send on purpose</h2>
      <p>
        If you email {site.email}, Kay will have whatever you put in that message, including your
        email address. That mail is used to reply, not to build a marketing list.
      </p>
      <h2>Hosting and server logs</h2>
      <p>
        The host that serves this site may collect standard request data such as IP address,
        browser type, and the pages requested. That is controlled by the host, not by a tracker
        installed on these pages.
      </p>
      {
        site.features.analytics ? (
          <p>
            This site currently uses Google Analytics 4 (measurement ID {site.gaMeasurementId})
            to understand traffic and improve the site. Google Analytics may collect information
            such as pages viewed, approximate location, device or browser type, referral source,
            and interaction data. It uses cookies or similar technologies. Kay uses this for
            aggregate site-improvement purposes and does not use Analytics to identify you as an
            individual. You can limit Analytics through your browser and Google&apos;s{' '}
            <a href="https://tools.google.com/dlpage/gaoptout">Analytics opt-out browser add-on</a>
            , where it is available. Google&apos;s handling of that data is described in the{' '}
            <a href="https://policies.google.com/privacy">Google Privacy Policy</a>.
          </p>
        ) : (
          <p>This site does not currently embed an analytics script.</p>
        )
      }
      <p>
        <a href="https://policies.google.com/technologies/partner-sites">
          How Google uses data when you use our partners&apos; sites or apps
        </a>
      </p>
      {
        site.features.adsense ? (
          <>
            <p>
              This site uses Google advertising. Third-party vendors, including Google, use cookies
              to serve ads based on a visitor&apos;s prior visits to this site or other sites.
              Google&apos;s use of advertising cookies lets Google and its partners serve ads based
              on those visits. This site has not added a separate advertising network, so it does
              not list other ad vendors here.
            </p>
            <p>
              You can opt out of personalized advertising in{' '}
              <a href="https://adssettings.google.com/">Google Ads Settings</a>. You can also opt
              out of some third-party cookies used for personalized advertising at{' '}
              <a href="https://www.aboutads.info/">aboutads.info</a>.
            </p>
          </>
        ) : (
          <p>
            This site does not currently embed advertising scripts. It does not serve Google ads,
            set advertising cookies, or offer personalized ads. If advertising scripts are added,
            this page will be updated before they run, including a link to Google Ads Settings for
            visitors who want to opt out of personalized advertising.
          </p>
        )
      }
      {
        site.features.emailSubscribe ? (
          <p>If you join an email list, that provider will store the address you submit.</p>
        ) : (
          <p>This site does not currently offer an email subscription form.</p>
        )
      }
      <h2>Affiliate links</h2>
      <p>
        Some future product links may be affiliate links. Those merchants have their own privacy
        policies. See the <a href="/affiliate-disclosure/">affiliate disclosure</a>.
      </p>
      <h2>Children</h2>
      <p>This site is not directed at children under 13.</p>
      <h2>Changes</h2>
      <p>
        If ads, an email service, or other trackers are added later, or if Analytics settings
        change, this page will be updated to match what is actually installed.
      </p>
      <h2>Contact</h2>
      <p>Questions: <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>
</BaseLayout>
