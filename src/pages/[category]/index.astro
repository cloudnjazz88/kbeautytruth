---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import {
  getPostsByCategory,
  getPublishedPosts,
  getRepurchasedPosts,
  type Post,
} from '../../lib/posts';
import { postCategories, type PostCategory } from '../../site';

export function getStaticPaths() {
  return [...postCategories, 'repurchased'].map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
if (!category) {
  throw new Error('Missing category');
}

const copy: Record<string, { title: string; description: string; intro: string }> = {
  reviews: {
    title: 'Reviews',
    description: 'Personal notes on K-beauty products Kay bought and used.',
    intro: 'Reviews stay unpublished until Kay can fill in the use details she actually remembers.',
  },
  breakouts: {
    title: "What Didn't Work",
    description: 'Products Kay stopped using because of breakouts, irritation, dryness, pilling, or disappointing results.',
    intro: "These are records of what did not work for Kay's skin, not verdicts on the products or predictions for every skin type.",
  },
  comparisons: {
    title: 'Comparisons',
    description: 'Side-by-side notes written only after both products have been used.',
    intro: 'A comparison page will not go up until both products have confirmed use notes.',
  },
  routines: {
    title: 'Routines',
    description: 'How Kay actually uses the products on her shelf.',
    intro: 'Routine pages wait until morning and night order can be written without guesswork.',
  },
  ingredients: {
    title: 'Ingredients',
    description: 'Clear, practical columns about skincare ingredients and how they fit into a routine.',
    intro:
      'Ingredient notes look beyond trend-driven claims to explain what an ingredient is, why it appears in skincare, and what to consider when adding it to a routine.',
  },
  trends: {
    title: 'Trends',
    description: 'Thoughtful columns on current K-beauty launches, routines, ingredients, and conversations.',
    intro:
      'A closer look at what is gaining attention in beauty, with enough context to separate a useful shift from short-lived hype.',
  },
  'beyond-k-beauty': {
    title: 'Beyond K-Beauty',
    description: 'Notes on non-Korean products, labeled separately from K-beauty reviews.',
    intro:
      'This section exists so non-Korean products are not mixed into Korean review lists. There are no published notes here yet.',
  },
  repurchased: {
    title: 'Repurchased',
    description: 'Products Kay finished and bought again.',
    intro: 'A repurchase note is only listed after the review is published.',
  },
};

const page = copy[category];
if (!page) {
  throw new Error(`Unknown category: ${category}`);
}

let posts: Post[] = [];
const ingredientTopics = ['PDRN', 'Retinol', 'Niacinamide', 'Copper Peptides'];
if (category === 'repurchased') {
  posts = await getRepurchasedPosts();
} else if ((postCategories as readonly string[]).includes(category)) {
  posts = await getPostsByCategory(category as PostCategory);
} else {
  posts = await getPublishedPosts();
}

function topicHasPublishedPost(topic: string, ingredientPosts: Post[]): boolean {
  const needle = topic.toLowerCase();
  return ingredientPosts.some((post) => {
    const haystack = [
      post.data.slug,
      post.data.title,
      post.data.productName ?? '',
    ]
      .join(' ')
      .toLowerCase();
    return haystack.includes(needle);
  });
}

const remainingPlannedTopics =
  category === 'ingredients'
    ? ingredientTopics.filter((topic) => !topicHasPublishedPost(topic, posts))
    : [];
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonicalPath={`/${category}/`}
  noindex={posts.length === 0}
>
  <section class="stack-page">
    <div class="wrap">
      <h1 class="page-title">{page.title}</h1>
      <p class="lede">{page.intro}</p>
      {
        posts.length > 0 && (
          <div class="card-grid" style="margin-top: 2rem;">
            {posts.map((post) => (
              <PostCard post={post} headingLevel={2} />
            ))}
          </div>
        )
      }
      {
        remainingPlannedTopics.length > 0 && (
          <div class="ingredient-topic-grid" style={posts.length > 0 ? 'margin-top: 1.5rem;' : undefined}>
            {remainingPlannedTopics.map((topic) => (
              <article class="ingredient-topic-card">
                <span>PLANNED COLUMN</span>
                <h2>{topic}</h2>
                <p>What it is, what to realistically expect, and where it may fit in a routine.</p>
              </article>
            ))}
          </div>
        )
      }
      {
        posts.length === 0 && remainingPlannedTopics.length === 0 && category !== 'ingredients' && (
          <p class="empty-copy">No published notes in this section yet.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .ingredient-topic-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .ingredient-topic-card {
    min-height: 13rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-card);
  }

  .ingredient-topic-card span {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .ingredient-topic-card h2 {
    margin: 2.2rem 0 0.6rem;
    font-family: var(--font-serif);
    font-size: 1.45rem;
  }

  .ingredient-topic-card p {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .ingredient-topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .ingredient-topic-grid { grid-template-columns: 1fr; }
  }
</style>
