---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';
---

<BaseLayout
  title="Contact"
  description="How to reach Kay at K-Beauty Truth."
  canonicalPath="/contact/"
>
  <section class="stack-page">
    <div class="wrap prose">
      <h1 class="page-title">Contact</h1>
      <p>
        The most reliable way to reach this site is email. There is no contact form on this page
        because a form is not connected to a working mail service yet.
      </p>
      <p>
        Email: <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p>
        Please do not write for medical advice. Kay can talk about her own routine and product
        notes. She cannot tell you what your skin will do.
      </p>
    </div>
  </section>
</BaseLayout>
