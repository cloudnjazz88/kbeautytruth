{
  "name": "kbeautytruth",
  "main": "workers/force-https.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "kbeautytruth.com",
      "custom_domain": true
    }
  ]
}
